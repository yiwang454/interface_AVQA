# Local OpenAI-compatible Qwen server. Use EMPTY for an unauthenticated server.
QWEN_BASE_URL=
QWEN_API_KEY=EMPTY

# Fixed text reasoner for caption_then_text_qa.
TEXT_REASONER_MODEL=openai/gpt-4.1
TEXT_REASONER_API_KEY=
TEXT_REASONER_API_BASE=

# GEPA reflection LM and COPRO/MIPROv2 prompt LM. Any model supported by
# DSPy/LiteLLM can be used; these defaults use the public OpenAI API.
GEPA_REFLECTION_MODEL=openai/gpt-4.1
GEPA_REFLECTION_API_KEY=
GEPA_REFLECTION_API_BASE=

OPTIMIZER_PROMPT_MODEL=openai/gpt-4.1
OPTIMIZER_PROMPT_API_KEY=
OPTIMIZER_PROMPT_API_BASE=

# Official Vertex AI Gemini endpoint. Include the project and location:
# https://aiplatform.googleapis.com/v1/projects/<project-id>/locations/<location>/publishers/google
GEMINI_BASE_URL=

# Choose either an API key or a service-account JSON file. Leave the unused
# setting empty. GOOGLE_APPLICATION_CREDENTIALS must be an absolute path.
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Local media is embedded by default. Set this to gcs to send fileData URIs.
GEMINI_MEDIA_MODE=inline
GEMINI_LOCAL_DATA_ROOT=
GEMINI_GCS_DATA_ROOT=

# Example GCS media settings:
# GEMINI_MEDIA_MODE=gcs
# GEMINI_LOCAL_DATA_ROOT=/local/dataset/root
# GEMINI_GCS_DATA_ROOT=gs://bucket/dataset/root
